# HTTPS direto no IP, com certificado da Let's Encrypt. Certificados de IP só existem no perfil
# "shortlived" (validade de ~6 dias); o Caddy renova sozinho. PUBLIC_IP vem do arquivo .env.
# Quando houver domínio: troque {$PUBLIC_IP} pelo domínio e remova default_sni e cert_issuer.
{
	default_sni {$PUBLIC_IP}
	cert_issuer acme {
		profile shortlived
	}
}

{$PUBLIC_IP} {
	# Arquivos para download (ex.: o instalador do app), em /srv/screencord/downloads no VPS.
	# https://<ip>/download/ScreenCord-Setup.msi
	handle_path /download/* {
		root * /srv/downloads
		file_server
	}

	handle {
		reverse_proxy api:8080
	}
}
