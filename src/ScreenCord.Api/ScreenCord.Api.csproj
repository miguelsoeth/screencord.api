<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Versão de desenvolvimento. No release, o CI passa a versão da tag git (-p:Version=1.2.3). -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Painel de observabilidade servido em /admin. -->
    <EmbeddedResource Include="Observability\dashboard.html" LogicalName="ScreenCord.Api.Observability.dashboard.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenCord.Contracts\ScreenCord.Contracts.csproj" />
  </ItemGroup>

</Project>
